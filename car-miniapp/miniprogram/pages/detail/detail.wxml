<view class="screen detail-screen">
  <view class="status-bar"><text>9:41</text><text class="status-icons">📶 📡 🔋</text></view>
  <view class="nav-bar">
    <view class="nav-left" bindtap="goBack">‹</view>
    <view class="nav-title">{{detail.navTitle}}</view>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="content detail-content" scroll-y enhanced>
    <view wx:if="{{loading}}" class="state">详情加载中...</view>
    <view wx:elif="{{errorText}}" class="state error">{{errorText}}</view>

    <block wx:else>
      <view class="detail-hero {{detail.tone}}">
        <view class="hero-copy">
          <text class="detail-code">{{detail.heroTitle}}</text>
          <text class="detail-name">{{detail.heroSub}}</text>
          <text class="detail-level">🔧 {{detail.heroTag}}</text>
        </view>
        <text class="detail-bg">⚠</text>
      </view>

      <view class="detail-card">
        <view class="detail-card-title">{{detail.reasonTitle}}</view>
        <view wx:for="{{detail.reasonLines}}" wx:key="text" class="detail-line">
          {{index + 1}}. {{item.text}}
        </view>
      </view>

      <view class="detail-card">
        <view class="detail-card-title">{{detail.stepTitle}}</view>
        <view wx:for="{{detail.steps}}" wx:key="no" class="step-item">
          <text class="step-num">{{item.no}}</text>
          <text class="step-text">{{item.text}}</text>
        </view>
      </view>

      <view class="detail-card">
        <view class="detail-card-title">{{detail.priceTitle}}</view>
        <view class="price-box">
          <text class="price-label">{{detail.priceLabel}}</text>
          <text class="price-value">{{detail.priceValue}}</text>
        </view>
        <view wx:for="{{detail.priceParts}}" wx:key="text" class="price-line">· {{item.text}}</view>
      </view>

      <view class="detail-card warn-card">
        <view class="detail-card-title warn-title">{{detail.warnTitle}}</view>
        <view class="warn-text">{{detail.warnText}}</view>
      </view>

      <view class="primary-btn detail-consult-btn" bindtap="goChat">立即咨询 Agent</view>
    </block>
  </scroll-view>
</view>
