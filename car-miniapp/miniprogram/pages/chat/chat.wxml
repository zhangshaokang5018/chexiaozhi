<view class="screen chat-screen">
  <view class="status-bar">
    <text>9:41</text>
    <text class="status-icons">📶 📡 🔋</text>
  </view>

  <view class="nav-bar">
    <view class="nav-left" bindtap="goHome">‹</view>
    <view class="nav-title">汽车维修翻译官</view>
    <view class="nav-right">⋯</view>
  </view>

  <scroll-view class="chat-content" scroll-y enhanced scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
    <view class="connection {{connected ? 'connection-ok' : 'connection-warn'}}" bindtap="checkConnection">
      <text wx:if="{{loading}}">服务检测中...</text>
      <text wx:elif="{{connected}}">服务已连接 · {{pingResult.version}}</text>
      <text wx:else>{{statusText}}</text>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.type == 'user'}}" class="msg user" id="msg-{{item.id}}">
        <view class="bubble">
          <view wx:if="{{item.imageLabel}}" class="bubble-img">图片模式：{{item.imageLabel}}</view>
          <view>{{item.text}}</view>
        </view>
      </view>

      <view wx:else class="msg bot {{item.type == 'loading' ? 'loading' : ''}}" id="msg-{{item.id}}">
        <view class="agent-label" wx:if="{{item.agentMeta}}">
          <text class="dot">●</text>{{item.agentMeta.name}}<text wx:if="{{item.agentMeta.desc}}"> · {{item.agentMeta.desc}}</text>
        </view>
        <view class="bubble">
          <view wx:if="{{item.steps && item.steps.length}}" class="steps">
            <text wx:for="{{item.steps}}" wx:for-item="s" wx:key="name" class="step">
              {{s.status == 'done' ? '✓' : s.status == 'doing' ? '→' : '○'}} {{s.name}}
            </text>
          </view>
          <view wx:if="{{item.route}}" class="route">识别意图：<text>{{item.route.intent}}</text>（{{item.route.confidenceText}}）</view>
          <view class="t" wx:if="{{item.reply.title}}">{{item.reply.title}}</view>
          <block wx:if="{{item.reply.blocks}}">
            <view wx:for="{{item.reply.blocks}}" wx:for-item="b" wx:key="label" class="kv {{b.type == 'danger' ? 'danger-block' : ''}}">
              <view wx:if="{{b.type == 'warn'}}" class="warn">{{b.text}}</view>
              <view wx:else>
                <text class="kv-label">{{b.label}}：</text>
                <text class="{{b.type == 'danger' || b.danger ? 'red' : b.good ? 'green' : ''}}">{{b.value}}</text>
              </view>
            </view>
          </block>
          <view class="price" wx:if="{{item.reply.price_text}}">{{item.reply.price_text}}</view>
          <view class="legal" wx:if="{{item.legal_note}}">{{item.legal_note}}</view>
        </view>
      </view>
    </block>

    <view wx:if="{{loadingAgent}}" class="typing">AI 正在思考...</view>
    <view class="chat-space"></view>
  </scroll-view>

  <view class="chat-input-bar">
    <scroll-view class="chips" scroll-x enhanced show-scrollbar="{{false}}">
      <text class="chip" bindtap="quickAsk" data-text="咕噜咕噜响">症状：咕噜咕噜响</text>
      <text class="chip" bindtap="quickAsk" data-text="P0300 是什么意思">故障码：P0300</text>
      <text class="chip" bindtap="quickAsk" data-text="800 元换机油机滤合理吗">报价：机油机滤</text>
      <text class="chip" bindtap="quickAsk" data-text="拍报价单" data-mode="image" data-image-label="报价单">图片：拍报价单</text>
    </scroll-view>
    <view class="chat-input-row">
      <textarea
        class="input"
        value="{{inputText}}"
        placeholder="描述你的车辆问题..."
        auto-height
        bindinput="onInput"
        maxlength="500"
      />
      <button class="send" bindtap="send" disabled="{{!canSend || loadingAgent}}">发送</button>
    </view>
  </view>

  <view class="tabbar">
    <view class="tabbar-item" bindtap="goHome"><text class="tabbar-icon">🏠</text><text>首页</text></view>
    <view class="tabbar-item active"><text class="tabbar-icon">💬</text><text>咨询</text></view>
    <view class="tabbar-item" bindtap="goKb"><text class="tabbar-icon">📚</text><text>知识库</text></view>
    <view class="tabbar-item" bindtap="goProfile"><text class="tabbar-icon">👤</text><text>我的</text></view>
  </view>
</view>
