<view class="screen home-screen">
  <view class="status-bar">
    <text>9:41</text>
    <text class="status-icons">📶 📡 🔋</text>
  </view>

  <view class="nav-bar">
    <view class="nav-left menu-trigger" bindtap="goProfile">☰</view>
    <view class="nav-title">车小智</view>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="content home-content" scroll-y enhanced scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
    <view class="hero">
      <view class="hero-copy">
        <text class="hero-title">我是车小智</text>
        <text class="hero-title">您的车况解读伙伴</text>
        <text class="hero-desc">遇到故障不用慌，赶紧告诉我～</text>
      </view>
      <view class="hero-mascot">
        <image class="hero-mascot-img" src="/assets/chexiaozhi_ms.png" mode="aspectFit" />
      </view>
    </view>

    <view class="diagnosis-card" bindtap="askHot" data-ask="发动机黄灯亮是什么原因？">
      <view class="diagnosis-head">
        <text class="diagnosis-icon">⚡</text>
        <text class="diagnosis-title">车况健康提醒</text>
      </view>
      <text class="diagnosis-main">{{context.car_tag || '当前车辆'}} · 建议定期读取 OBD 故障码</text>
      <text class="diagnosis-sub">点击让 Agent 帮你解释故障灯、症状和维修报价。</text>
    </view>

    <view class="section-title">🔥 热门咨询</view>
    <view class="hot-questions">
      <view class="hot-question" bindtap="askHot" data-ask="800 元换故障灯贵吗？"><text>1</text><view>800 元换故障灯贵吗</view><text class="arr">›</text></view>
      <view class="hot-question" bindtap="askHot" data-ask="通用 OBD 故障码怎么解读？"><text>2</text><view>通用 OBD 故障码解读</view><text class="arr">›</text></view>
      <view class="hot-question" bindtap="askHot" data-ask="我的特斯拉过保了去哪修？"><text>3</text><view>我的特斯拉过保了去哪修</view><text class="arr">›</text></view>
      <view class="hot-question" bindtap="askHot" data-ask="充电桩显示握手失败，指示灯闪烁怎么办？"><text>4</text><view>充电桩显示握手失败，指示灯闪烁</view><text class="arr">›</text></view>
    </view>

    <view class="home-chat-list" wx:if="{{messages.length}}">
      <block wx:for="{{messages}}" wx:key="id">
        <view class="home-msg {{item.type == 'user' ? 'user' : 'agent'}} {{item.type == 'loading' ? 'loading' : ''}}" id="home-msg-{{item.id}}">
          <view class="home-bubble">
            <image wx:if="{{item.imagePath}}" class="home-bubble-photo" src="{{item.imagePath}}" mode="aspectFill" />
            <view wx:if="{{item.imageLabel}}" class="home-image-label">图片：{{item.imageLabel}}</view>
            <view wx:if="{{item.type == 'user'}}">{{item.text}}</view>
            <block wx:else>
              <view class="home-agent-label">{{item.agentName}} · {{item.intent}}（{{item.confidenceText}}）</view>
              <view class="home-answer-title" wx:if="{{item.reply.title}}">{{item.reply.title}}</view>
              <view class="home-answer-summary" wx:if="{{item.reply.summary}}">{{item.reply.summary}}</view>
              <block wx:if="{{item.reply.blocks}}">
                <view wx:for="{{item.reply.blocks}}" wx:for-item="b" wx:key="label" class="home-answer-block {{b.type == 'warn' ? 'warn' : b.type == 'danger' ? 'danger' : ''}}">
                  <text wx:if="{{b.type == 'warn'}}">⚠️ {{b.text}}</text>
                  <text wx:elif="{{b.type == 'danger'}}">🚨 {{b.text || b.value}}</text>
                  <text wx:else>{{b.label}}：{{b.value}}</text>
                </view>
              </block>
              <view class="home-price" wx:if="{{item.reply.price_text}}">{{item.reply.price_text}}</view>
              <view class="home-legal" wx:if="{{item.legal_note}}">{{item.legal_note}}</view>
            </block>
          </view>
        </view>
      </block>
    </view>

    <view class="home-space"></view>
  </scroll-view>

  <view class="home-input-wrap">
    <scroll-view class="home-quick-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <text class="qt" bindtap="goCamera" data-label="仪表盘">💡 拍故障灯</text>
      <text class="qt" bindtap="goCamera" data-label="报价单">📋 拍维修单</text>
      <text class="qt" bindtap="askHot" data-ask="P0300 是什么意思">⚠️ 故障码</text>
      <text class="qt" bindtap="goKb">🔧 维修指南</text>
    </scroll-view>
    <view class="home-input-row">
      <view class="input-icon-btn camera-icon" bindtap="goCamera" data-label="仪表盘">📷</view>
      <view
        class="input-icon-btn mic-icon {{recording ? 'recording' : ''}}"
        bindtouchstart="startRecord"
        bindtouchend="finishRecord"
        bindtouchcancel="cancelRecord"
      >{{recording ? '●' : transcribing ? '…' : '🎤'}}</view>
      <input
        class="home-input"
        value="{{inputText}}"
        placeholder="{{recording ? '松手发送语音...' : loadingAgent ? '车小智正在分析...' : '快来描述你遇到的问题～ ✨'}}"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="sendHomeText"
      />
      <view class="input-icon-btn send-icon" bindtap="sendHomeText">➤</view>
    </view>
  </view>
</view>
