<view class="screen">
  <view class="status-bar">
    <text>9:41</text>
    <text class="status-icons">📶 📡 🔋</text>
  </view>

  <view class="nav-bar">
    <view class="nav-left"></view>
    <view class="nav-title">汽车维修翻译官</view>
    <view class="nav-right">⋯</view>
  </view>

  <scroll-view class="content home-content" scroll-y>
    <view class="banner">
      <view class="banner-copy">
        <text class="banner-title">遇到故障不用慌</text>
        <text class="banner-desc">AI Agent 帮你解读症状、故障码和报价</text>
      </view>
      <text class="banner-car">🚗</text>
    </view>

    <view class="grid-4">
      <view class="mini-card" bindtap="goChat">
        <text class="emoji">🎙️</text>
        <text class="label">描述症状</text>
      </view>
      <view class="mini-card" bindtap="goDetail" data-code="P0300">
        <text class="emoji">⚠️</text>
        <text class="label">故障码</text>
      </view>
      <view class="mini-card" bindtap="goChat">
        <text class="emoji">📷</text>
        <text class="label">拍照识别</text>
      </view>
      <view class="mini-card" bindtap="goChat">
        <text class="emoji">💰</text>
        <text class="label">报价审核</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">🚘 我的车辆 <text class="tag">{{context.car_tag}}</text></view>
      <view class="vehicle-meta">
        <text>里程 <text class="strong">{{context.mileage}}</text> · 所在地 <text class="strong">{{context.location}}</text></text>
        <text>VIN <text class="mono">{{context.vin}}</text></text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">⚡ 快速开始</view>
      <view class="quick-item" bindtap="goChat">
        <text class="quick-emoji">🔧</text>
        <view class="quick-info">
          <text class="quick-title">发动机咕噜咕噜响</text>
          <text class="quick-desc">常见故障 · 点击立即咨询</text>
        </view>
        <text class="quick-arrow">›</text>
      </view>
      <view class="quick-item" bindtap="goChat">
        <text class="quick-emoji">🛞</text>
        <view class="quick-info">
          <text class="quick-title">刹车片磨损报警</text>
          <text class="quick-desc">高紧急度 · 建议尽快处理</text>
        </view>
        <text class="quick-arrow">›</text>
      </view>
      <view class="quick-item" bindtap="goChat">
        <text class="quick-emoji">💸</text>
        <view class="quick-info">
          <text class="quick-title">800元换机油机滤？</text>
          <text class="quick-desc">报价是否合理 · 一键审核</text>
        </view>
        <text class="quick-arrow">›</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">🔥 热门故障</view>
      <view class="hot-list">
        <text class="hot-tag" bindtap="goDetail" data-code="P0300"><text class="rank">1</text>P0300 缺火</text>
        <text class="hot-tag" bindtap="goChat"><text class="rank">2</text>怠速抖动</text>
        <text class="hot-tag" bindtap="goChat"><text class="rank">3</text>刹车异响</text>
        <text class="hot-tag" bindtap="goChat"><text class="rank">4</text>机油报警</text>
        <text class="hot-tag" bindtap="goChat"><text class="rank">5</text>换挡顿挫</text>
        <text class="hot-tag" bindtap="goChat"><text class="rank">6</text>水温过高</text>
      </view>
    </view>
  </scroll-view>
</view>
