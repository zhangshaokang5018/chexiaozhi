<view class="screen home-screen">
  <view class="status-bar">
    <text>9:41</text>
    <text class="status-icons">📶 📡 🔋</text>
  </view>

  <view class="nav-bar">
    <view class="nav-left menu-trigger" bindtap="goProfile">☰</view>
    <view class="nav-title">车小智</view>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="content home-content" scroll-y enhanced>
    <view class="hero">
      <view class="hero-copy">
        <text class="hero-title">我是车小智</text>
        <text class="hero-title">您的车况解读伙伴</text>
        <text class="hero-desc">遇到故障不用慌，赶紧告诉我～</text>
      </view>
      <view class="hero-mascot">
        <image class="hero-mascot-img" src="/assets/chexiaozhi_ms.png" mode="aspectFit" />
      </view>
    </view>

    <view class="diagnosis-card" bindtap="askHot" data-ask="发动机黄灯亮是什么原因？">
      <view class="diagnosis-head">
        <text class="diagnosis-icon">⚡</text>
        <text class="diagnosis-title">车况健康提醒</text>
      </view>
      <text class="diagnosis-main">{{context.car_tag || '当前车辆'}} · 建议定期读取 OBD 故障码</text>
      <text class="diagnosis-sub">点击让 Agent 帮你解释故障灯、症状和维修报价。</text>
    </view>

    <view class="vehicle-card" bindtap="goProfile">
      <view class="vehicle-title">
        <text>🚘 当前车辆</text>
        <text class="vehicle-badge">{{context.location || '未设置所在地'}}</text>
      </view>
      <view class="vehicle-row"><text>车型</text><text>{{context.car_model || '去我的页补充车型'}}</text></view>
      <view class="vehicle-row"><text>里程</text><text>{{context.mileage || '未填写'}}</text></view>
      <view class="vehicle-row"><text>VIN</text><text>{{context.vin || '未填写'}}</text></view>
    </view>

    <view class="section-title">🔥 热门咨询</view>
    <view class="hot-questions">
      <view class="hot-question" bindtap="askHot" data-ask="800 元换故障灯贵吗？"><text>1</text><view>800 元换故障灯贵吗</view><text class="arr">›</text></view>
      <view class="hot-question" bindtap="askHot" data-ask="通用 OBD 故障码怎么解读？"><text>2</text><view>通用 OBD 故障码解读</view><text class="arr">›</text></view>
      <view class="hot-question" bindtap="askHot" data-ask="我的特斯拉过保了去哪修？"><text>3</text><view>我的特斯拉过保了去哪修</view><text class="arr">›</text></view>
      <view class="hot-question" bindtap="askHot" data-ask="充电桩显示握手失败，指示灯闪烁怎么办？"><text>4</text><view>充电桩显示握手失败，指示灯闪烁</view><text class="arr">›</text></view>
    </view>

    <view class="home-space"></view>
  </scroll-view>

  <view class="home-input-wrap">
    <scroll-view class="home-quick-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <text class="qt" bindtap="goCamera" data-label="仪表盘">💡 拍故障灯</text>
      <text class="qt" bindtap="goCamera" data-label="报价单">📋 拍维修单</text>
      <text class="qt" bindtap="askHot" data-ask="P0300 是什么意思">⚠️ 故障码</text>
      <text class="qt" bindtap="goKb">🔧 维修指南</text>
    </scroll-view>
    <view class="home-input-row">
      <button class="round-btn" bindtap="goCamera" data-label="仪表盘">📷</button>
      <input
        class="home-input"
        value="{{inputText}}"
        placeholder="快来描述你遇到的问题～ ✨"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="sendHomeText"
      />
      <button class="round-btn send" bindtap="sendHomeText">🎤</button>
    </view>
  </view>
</view>
