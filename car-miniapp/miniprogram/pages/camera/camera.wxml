<view class="camera-screen">
  <view class="status-bar camera-status">
    <text>9:41</text>
    <text class="status-icons">📶 📡 🔋</text>
  </view>

  <view class="nav-bar camera-nav">
    <view class="nav-left" bindtap="goBack">‹</view>
    <view class="nav-title">{{title}}</view>
    <view class="nav-right">💡</view>
  </view>

  <view class="camera-stage">
    <view class="finder">
      <view class="finder-icon">{{icon}}</view>
      <view class="corner lt"></view>
      <view class="corner rt"></view>
      <view class="corner lb"></view>
      <view class="corner rb"></view>
      <view class="scan-line"></view>
      <view class="camera-tip">{{tip}}</view>
    </view>

    <view class="mode-row">
      <view class="mode {{label == '仪表盘' ? 'active' : ''}}" data-label="仪表盘" bindtap="switchMode">故障灯</view>
      <view class="mode {{label == '报价单' ? 'active' : ''}}" data-label="报价单" bindtap="switchMode">维修单</view>
      <view class="mode {{label == '零件' ? 'active' : ''}}" data-label="零件" bindtap="switchMode">零件</view>
    </view>

    <view class="camera-actions">
      <button class="side-btn" bindtap="pickFromAlbum">🖼</button>
      <button class="shutter" bindtap="takePhoto" loading="{{choosing}}">
        <view></view>
      </button>
      <button class="side-btn" bindtap="switchMode">🔄</button>
    </view>

    <view class="camera-copy">
      选择或拍摄后会进入对话页，由后端读取数据库 Key 调用真实视觉大模型。
    </view>
  </view>
</view>
