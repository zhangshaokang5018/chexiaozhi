<view class="screen kb-screen">
  <view class="status-bar"><text>9:41</text><text class="status-icons">📶 📡 🔋</text></view>
  <view class="nav-bar">
    <view class="nav-left" bindtap="goBack">‹</view>
    <view class="nav-title">车小智</view>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="content kb-content" scroll-y enhanced>
    <view class="kb-hero">
      <view class="hero-title">保养维修指南</view>
      <view class="hero-sub">修车前花10秒查一下，心里有底不花冤枉钱。</view>
    </view>

    <view class="search-panel">
      <input
        class="search-input"
        value="{{searchText}}"
        placeholder="搜索关键词（如：P0300、刹车异响）"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="searchKb"
      />
      <view class="search-btn" bindtap="searchKb">🔍</view>
    </view>

    <view class="filter-row">
      <text class="filter {{searchText == 'P0420' ? 'active' : ''}}" data-kind="dtc" data-keyword="P0420" data-query="P0420" bindtap="quickSearch">P0420</text>
      <text class="filter {{searchText == '刹车异响' ? 'active' : ''}}" data-kind="symptom" data-keyword="刹车异响" data-query="刹车异响" bindtap="quickSearch">刹车异响</text>
      <text class="filter {{searchText == '保养周期' ? 'active' : ''}}" data-kind="cost" data-keyword="保养周期" data-query="更换机油机滤" bindtap="quickSearch">保养周期</text>
      <text class="filter {{searchText == '换刹车片多少钱' ? 'active' : ''}}" data-kind="cost" data-keyword="换刹车片多少钱" data-query="刹车片" bindtap="quickSearch">换刹车片多少钱</text>
    </view>

    <view wx:if="{{loading}}" class="state">知识库加载中...</view>
    <view wx:elif="{{errorText}}" class="state error">{{errorText}}</view>
    <view wx:elif="{{items.length == 0}}" class="state">没有匹配结果</view>

    <view wx:else class="kb-list">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="kb-item {{item.kind}} {{item.displayTone}}"
        data-kind="{{item.kind}}"
        data-id="{{item.id}}"
        data-ask="{{item.ask_text}}"
        bindtap="openItem"
      >
        <view class="kb-head">
          <text class="kb-title">{{item.displayTitle}}</text>
        </view>
        <view class="kb-summary">{{item.displaySummary}}</view>
        <view class="kb-detail">{{item.displayDetail}}</view>
        <view class="kb-meta">
          <text wx:if="{{item.displayMeta}}" class="meta-price">{{item.displayMeta}}</text>
          <text wx:if="{{item.statusText}}" class="meta-status">{{item.statusText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!overviewMode && !loading && !errorText && items.length < total}}" class="load-more">
      <button class="load-more-btn" bindtap="loadMore" disabled="{{loadingMore}}">
        {{loadingMore ? '加载中...' : '加载更多'}}
      </button>
    </view>
    <view wx:elif="{{!overviewMode && !loading && !errorText && items.length > 0 && items.length >= total}}" class="load-more done">
      已加载全部 {{total}} 条
    </view>
  </scroll-view>
</view>
